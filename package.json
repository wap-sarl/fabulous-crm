    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "^8.0.14"
