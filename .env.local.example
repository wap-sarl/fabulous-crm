# ── Convex CLI ───────────────────────────────────────────────────────────────
# Which deployment `bunx convex dev` / `bunx convex run` target.
# Both values are written automatically by the first `bunx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name # team: your-team, project: wap-crm

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Required. Convex deployment URL the SPA connects to.
# In production this is injected at container start via /env.js (window.__ENV__),
# generated from the container's VITE_* environment variables.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Written by `convex dev` but not read by the app: the HTTP-actions URL is
# derived at runtime from VITE_CONVEX_URL (.convex.cloud → .convex.site).
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Optional. Enables Google Places autocomplete on the lead address field;
# without it the form falls back to manual address entry.
# VITE_GOOGLE_MAPS_API_KEY=
