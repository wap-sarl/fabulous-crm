{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2021", "dom"],
    "types": ["bun", "node"],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"]
}
